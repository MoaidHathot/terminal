<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2013/05/nuspec.xsd">
  <metadata>
    <!-- The version comes from `nuget pack -Version`; the commit from -Properties commit=... -->
    <id>OverShell.Terminal.Wpf</id>
    <version>0.0.0</version>
    <authors>MoaidHathot</authors>
    <description>The Windows Terminal WPF control - Microsoft.Terminal.Wpf (managed HwndHost) and Microsoft.Terminal.Control (the native parser, buffer and AtlasEngine renderer) - built from source by OverShell's fork of microsoft/terminal, for OverShell. The README names the upstream commit it was built from and every patch on top of it.</description>
    <license type="expression">MIT</license>
    <projectUrl>https://github.com/MoaidHathot/terminal/tree/overshell/build/overshell</projectUrl>
    <repository type="git" url="https://github.com/MoaidHathot/terminal" branch="overshell" commit="$commit$" />
    <readme>README.md</readme>
    <tags>terminal windows-terminal wpf conpty overshell</tags>
    <dependencies>
      <group targetFramework=".NETFramework4.7.2" />
      <group targetFramework="net8.0-windows7.0" />
    </dependencies>
    <frameworkReferences>
      <group targetFramework="net8.0-windows7.0">
        <frameworkReference name="Microsoft.WindowsDesktop.App.WPF" />
      </group>
    </frameworkReferences>
  </metadata>
  <files>
    <file src="lib\**" target="lib" />
    <file src="runtimes\**" target="runtimes" />
    <file src="README.md" target="" />
    <file src="LICENSE.txt" target="" />
  </files>
</package>
